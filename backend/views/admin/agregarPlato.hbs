<div class="container mt-4">
  <h2>Agregar Nuevo Plato</h2>

  {{#if error}}
    <div class="alert alert-danger">{{message}}</div>
  {{/if}}

  <form action="/admin/platos/agregar" method="POST" enctype="multipart/form-data">
    <div class="mb-3">
      <label class="form-label">Nombre *</label>
      <input type="text" name="nombre" class="form-control" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Descripción</label>
      <textarea name="descripcion" class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
      <label class="form-label">Precio *</label>
      <input type="number" step="0.01" name="precio" class="form-control" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Categoría</label>
      <input type="text" name="categoria" class="form-control" placeholder="Ej: Hamburguesas, Sushi, Milanesas...">
    </div>

    <div class="mb-3">
      <label class="form-label">Imagen</label>
      <input type="file" name="imagen" class="form-control" accept="image/*">
    </div>

    <button type="submit" class="btn btn-success">Guardar Plato</button>
    <a href="/admin/platos" class="btn btn-secondary">Cancelar</a>
  </form>
</div>
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Platos de Delivery</h2>
    <a href="/admin/platos/agregar" class="btn btn-success">+ Agregar Plato</a>
  </div>

  <table class="table table-striped table-bordered">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>Imagen</th>
        <th>Nombre</th>
        <th>Precio</th>
        <th>Categoría</th>
        <th>Activo</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each platos}}
      <tr>
        <td>{{id}}</td>
        <td>
          {{#if imagen}}
            <img src="{{imagen}}" alt="{{nombre}}" width="70" height="50" style="object-fit: cover;">
          {{else}}
            Sin imagen
          {{/if}}
        </td>
        <td>{{nombre}}</td>
        <td>${{precio}}</td>
        <td>{{categoria}}</td>
        <td>{{#if activo}}Sí{{else}}No{{/if}}</td>
        <td>
          <a href="/admin/platos/modificar/{{id}}" class="btn btn-sm btn-primary">Editar</a>
          <a href="/admin/platos/eliminar/{{id}}" class="btn btn-sm btn-danger" onclick="return confirm('¿Seguro que querés eliminar este plato?')">Eliminar</a>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>